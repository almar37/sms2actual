{
  "name": "sms2actual",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./web/tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "setup": "sh scripts/setup-docker.sh",
    "setup:host": "node --import tsx src/setup.ts",
    "smoke:actual": "node --import tsx scripts/smoke-actual.ts",
    "dev:web": "vite",
    "test:web": "npm run build && tsx scripts/smoke-web.ts"
  },
  "dependencies": {
    "@actual-app/api": "26.9.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.5.0",
    "luxon": "^3.7.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.17.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
