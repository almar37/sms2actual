# Copy to .env for manual configuration, or let npm run setup generate .env.
# Use existing Actual accounts and categories in config/accounts.yaml.
API_KEY=replace-with-a-long-random-secret
ACTUAL_SERVER_URL=http://actual:5006
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
ACTUAL_ENCRYPTION_PASSWORD=
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
CONFIG_PATH=/config/accounts.yaml
BANKS_CONFIG_PATH=/config/banks.yaml
PARSING_CONFIG_PATH=/config/parsing.yaml
DB_PATH=/data/events.sqlite
ACTUAL_CACHE_DIR=/actual-cache
PORT=3000
LOG_LEVEL=info
MAX_ATTEMPTS=5
ENRICHMENT_MIN_CONFIDENCE=0.70
MAPPING_REFRESH_MINUTES=60
# Existing Docker networks on the deployment host:
ACTUAL_NETWORK=shared-net
TUNNEL_NETWORK=streaming_flare-net
