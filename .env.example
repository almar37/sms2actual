# Optional: docker compose up -d works without this file.
# Complete owner creation, Actual connection, account routing, and AI setup in the web UI.

# Exact browser origin. Use your public HTTPS URL behind a reverse proxy.
PUBLIC_URL=http://localhost:3000
# Host listener; loopback keeps first-run owner creation local.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
# Additional exact browser origins, separated by commas.
TRUSTED_ORIGINS=

# For the optional networking overrides:
# PROXY_NETWORK=caddy
# ACTUAL_HOSTNAME=actual.example.com
# ACTUAL_HOST_IP=192.0.2.10

# Legacy environment configuration remains supported by compose.example.yaml.
# New installations generate and persist secrets in the sms-data volume instead.
# API_KEY=your-existing-long-random-secret
# AUTH_SECRET=your-existing-stable-secret-at-least-32-characters
# ACTUAL_SERVER_URL=http://actual:5006
# ACTUAL_PASSWORD=your-server-password
# ACTUAL_SYNC_ID=your-budget-sync-id
# ACTUAL_ENCRYPTION_PASSWORD=your-budget-encryption-password
# CONFIG_PATH=/config/accounts.yaml
# BANKS_CONFIG_PATH=/config/banks.yaml
# PARSING_CONFIG_PATH=/config/parsing.yaml
